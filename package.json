{
  "name": "browser-extensions",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.2",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build:extensions": "node scripts/build-extensions.mjs",
    "typecheck": "tsrs --noEmit",
    "vitest": "vitest",
    "dev": "node scripts/build-extensions.mjs --watch",
    "check": "pnpm run typecheck && pnpm run test",
    "build": "pnpm run typecheck && NODE_ENV=development pnpm run build:extensions",
    "dist": "pnpm run typecheck && NODE_ENV=production pnpm run build:extensions",
    "test": "pnpm run vitest run"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/chrome": "0.2.2",
    "@types/node": "26.6.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
