{
  "name": "browser-extensions",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.2",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build:extensions": "node scripts/build-extensions.mjs",
    "icons": "node scripts/render-icons.mjs",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --type-aware --threads=1",
    "vitest": "vitest",
    "dev": "node scripts/build-extensions.mjs --watch",
    "check": "pnpm run typecheck && pnpm run test",
    "build": "pnpm run typecheck && NODE_ENV=development pnpm run build:extensions",
    "dist": "pnpm run typecheck && NODE_ENV=production pnpm run build:extensions",
    "test": "pnpm run vitest run",
    "test:browser": "playwright test --config extension-onefile/playwright.config.ts",
    "test:browser:chatgpt": "playwright test --config extension-chatgpt/playwright.config.ts",
    "perf:onefile": "playwright test --config extension-onefile/playwright.perf.config.ts",
    "x": "node x-archive-cli/src/cli.ts",
    "onefile": "node onefile-cli/src/cli.ts"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/chrome": "0.2.2",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "^6.2.7",
    "oxlint": "1.93.0",
    "playwright": "1.64.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "vite": "8.3.2",
    "vitest": "5.0.5"
  }
}
