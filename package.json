{
  "name": "browser-extensions",
  "private": true,
  "packageManager": "pnpm@11.0.2",
  "scripts": {
    "build:extensions": "deno run --allow-env --allow-read --allow-write --allow-ffi --allow-sys=homedir,uid scripts/build-extensions.mjs",
    "typecheck": "tsc --noEmit",
    "vitest": "vitest",
    "dev": "deno run --allow-env --allow-read --allow-write --allow-ffi --allow-run --allow-sys=homedir,uid scripts/build-extensions.mjs --watch",
    "check": "pnpm run typecheck && pnpm run test",
    "build": "pnpm run typecheck && NODE_ENV=development pnpm run build:extensions",
    "dist": "pnpm run typecheck && NODE_ENV=production pnpm run build:extensions",
    "test": "pnpm run vitest run"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/chrome": "0.2.2",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
