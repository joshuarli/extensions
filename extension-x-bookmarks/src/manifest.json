{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "X Bookmarks",
  "version": "0.1.0",
  "description": "Archive X bookmarks and optional folders locally to JSON.",
  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "downloads"
  ],
  "host_permissions": ["https://x.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Export X bookmarks",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html"
}
