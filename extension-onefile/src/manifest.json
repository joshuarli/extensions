{
  "manifest_version": 3,
  "minimum_chrome_version": "110",
  "version": "0.1.0",
  "name": "Onefile",
  "description": "Save the current tab as a universal self-extracting ZIP.",
  "action": {
    "default_title": "Save this page as a universal archive.",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["activeTab", "scripting", "downloads"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
